{
  "family": "ecs-fargate-demo-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::481980074895:role/ecs-fargate-demo-task-execution-role",
  "taskRoleArn": "arn:aws:iam::481980074895:role/ecs-fargate-demo-task-role",
  "containerDefinitions": [
    {
      "name": "ecs-fargate-demo-container",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "APP_STORAGE",
          "value": "s3"
        }
      ],
      "secrets": [
        {
          "name": "IMAGES_BUCKET_NAME",
          "valueFrom": "arn:aws:ssm:eu-central-1:481980074895:parameter/photo-gallery/s3/images-bucket-name"
        },
        {
          "name": "CLOUDFRONT_DOMAIN",
          "valueFrom": "arn:aws:ssm:eu-central-1:481980074895:parameter/photo-gallery/cloudfront/domain-name"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-fargate-demo",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
